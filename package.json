{
  "name": "@ttis/root",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ttis/api dev & pnpm --filter @ttis/ui dev",
    "dev:api": "pnpm --filter @ttis/api dev",
    "dev:ui": "pnpm --filter @ttis/ui dev",
    "test": "pnpm -r run test",
    "format": "pnpm -r run format",
    "lint": "pnpm -r run lint",
    "build": "pnpm -r run build",
    "parse-csv": "tsx data/scripts/parse-csv.ts"
  },
  "devDependencies": {
    "csv-parse": "^6.1.0",
    "tsx": "^4.21.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "type-graphql"
    ],
    "ignoredBuiltDependencies": [
      "aws-sdk",
      "core-js",
      "es5-ext",
      "fsevents",
      "msw",
      "nodemon",
      "puppeteer",
      "sharp",
      "unrs-resolver"
    ]
  }
}
