# Dependencies
node_modules/
.pnpm-store/
.pnp
.pnp.js
.yarn/install-state.gz
# only using pnpm for deps
package-lock.json
# per-package lockfiles are artifacts from Docker builds; root lockfile is the source of truth
packages/*/pnpm-lock.yaml

# Build outputs
build/
dist/
out/
.next/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/

# Environment files
.env
.env.local
.env.*.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE / Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Vercel
.vercel

# Misc
*.pem
*.local

# AI
.claude/worktrees

# Turborepo
.turbo

# Terraform (redundant with terraform/.gitignore, but catches stray nesting elsewhere)
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/*.tfvars.json
**/*.tfplan
**/.terraform.tfstate.lock.info
