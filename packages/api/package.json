{
  "name": "@ttis/api",
  "version": "0.1.0",
  "private": false,
  "description": "GraphQL API for The Things I've Seen",
  "license": "MIT",
  "author": "Jesse Rinehart",
  "repository": {
    "type": "git",
    "url": "https://github.com/boxwhine/the-things-ive-seen.git"
  },
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "tsx watch ./src/",
    "lint": "oxlint --type-aware src",
    "types": "tsc --noEmit",
    "build": "pnpm run generate && tsc",
    "start": "node ./build/src/index.js",
    "generate": "prisma generate",
    "format": "oxfmt",
    "prisma": "prisma  --config ./prisma/prisma.config.ts",
    "db:reset": "pnpm run prisma migrate reset",
    "db:seed": "pnpm run prisma db seed",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest dev"
  },
  "dependencies": {
    "@pothos/core": "^4.12.0",
    "@pothos/plugin-prisma": "^4.14.2",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "dotenv": "^16.6.1",
    "graphql": "^16.13.2",
    "graphql-yoga": "^5.18.1",
    "pg": "^8.20.0",
    "prisma": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "nodemon": "^1.19.4",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "prisma-dbml-generator": "^0.12.0",
    "prisma-erd-generator": "^2.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
