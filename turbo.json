{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "generate": {
      "inputs": ["prisma/**"],
      "outputs": ["lib/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", ".next/**", "!.next/cache/**", "lib/**"]
    },
    "lint": {
      "dependsOn": ["generate", "^build"]
    },
    "types": {
      "dependsOn": ["generate", "^build"]
    },
    "test": {
      "dependsOn": ["generate", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
