{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "nextjs", "unicorn", "react", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [".next/**", "out/**", "build/**", "next-env.d.ts"]
}
