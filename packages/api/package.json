{
  "name": "@ttis/api",
  "version": "0.1.0",
  "description": "GraphQL API for The Things I've Seen",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/boxwhine/the-things-ive-seen.git"
  },
  "private": false,
  "author": "Jesse Rinehart",
  "license": "MIT",
  "main": "src/index.js",
  "scripts": {
    "dev": "tsx watch ./src/",
    "lint": "tsc --noEmit && eslint ./src/ --quiet --fix",
    "start": "tsc && node ./build/",
    "generate": "prisma generate",
    "format": "prettier --write .",
    "prisma": "prisma  --config ./prisma/prisma.config.ts",
    "db:reset": "pnpm run prisma migrate reset",
    "db:seed": "pnpm run prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest dev"
  },
  "dependencies": {
    "@pothos/core": "^4.12.0",
    "@pothos/plugin-prisma": "^4.14.2",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "dotenv": "^16.6.1",
    "graphql": "^16.13.2",
    "graphql-yoga": "^5.18.1",
    "pg": "^8.20.0",
    "prisma": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.19.37",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "nodemon": "^1.19.4",
    "prettier": "^3.8.1",
    "prisma-dbml-generator": "^0.12.0",
    "prisma-erd-generator": "^2.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^1.6.1"
  }
}
